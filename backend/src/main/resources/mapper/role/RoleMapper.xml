<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miniproject.role.domain.RoleRepository">

    <resultMap id="RoleResultMap" type="com.miniproject.role.domain.Role">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="RoleColumns">
        id, code, name, description, created_at
    </sql>

    <select id="findById" resultMap="RoleResultMap">
        SELECT <include refid="RoleColumns"/>
        FROM pjt_roles
        WHERE id = #{id}
    </select>

    <select id="findByCode" resultMap="RoleResultMap">
        SELECT <include refid="RoleColumns"/>
        FROM pjt_roles
        WHERE code = #{code}
    </select>

    <select id="existsByCode" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM pjt_roles WHERE code = #{code})
    </select>

    <select id="findAll" resultMap="RoleResultMap">
        SELECT <include refid="RoleColumns"/>
        FROM pjt_roles
        ORDER BY id ASC
    </select>

    <select id="findAllByOrderByIdAsc" resultMap="RoleResultMap">
        SELECT <include refid="RoleColumns"/>
        FROM pjt_roles
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO pjt_roles (code, name, description, created_at)
        VALUES (#{code}, #{name}, #{description}, #{createdAt})
    </insert>

    <update id="update">
        UPDATE pjt_roles
        SET code = #{code},
            name = #{name},
            description = #{description}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM pjt_roles WHERE id = #{id}
    </delete>

</mapper>
