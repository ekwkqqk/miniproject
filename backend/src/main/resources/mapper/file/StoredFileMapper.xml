<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.miniproject.file.domain.StoredFileRepository">

    <resultMap id="StoredFileResultMap" type="com.miniproject.file.domain.StoredFile">
        <id property="id" column="id"/>
        <result property="fileGroupId" column="file_group_id"/>
        <result property="originalName" column="original_name"/>
        <result property="storedName" column="stored_name"/>
        <result property="contentType" column="content_type"/>
        <result property="sizeBytes" column="size_bytes"/>
        <result property="uploadedBy" column="uploaded_by"/>
        <result property="uploadedByEmail" column="uploaded_by_email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="FileColumns">
        id, file_group_id, original_name, stored_name, content_type, size_bytes,
        uploaded_by, uploaded_by_email, created_at
    </sql>

    <select id="findById" resultMap="StoredFileResultMap">
        SELECT <include refid="FileColumns"/>
        FROM pjt_files
        WHERE id = #{id}
    </select>

    <select id="findByFileGroupId" resultMap="StoredFileResultMap">
        SELECT <include refid="FileColumns"/>
        FROM pjt_files
        WHERE file_group_id = #{fileGroupId}
        ORDER BY id ASC
    </select>

    <select id="nextFileGroupId" resultType="long">
        SELECT nextval('pjt_file_group_id_seq')
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO pjt_files (
            file_group_id, original_name, stored_name, content_type, size_bytes,
            uploaded_by, uploaded_by_email, created_at
        ) VALUES (
            #{fileGroupId}, #{originalName}, #{storedName}, #{contentType}, #{sizeBytes},
            #{uploadedBy}, #{uploadedByEmail}, #{createdAt}
        )
    </insert>

    <delete id="deleteById">
        DELETE FROM pjt_files WHERE id = #{id}
    </delete>

</mapper>
