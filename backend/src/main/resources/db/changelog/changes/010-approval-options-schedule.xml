<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-approval-options-schedule" author="miniproject">
        <addColumn tableName="pjt_approval_documents">
            <column name="doc_class" type="VARCHAR(20)" defaultValue="GENERAL">
                <constraints nullable="false"/>
            </column>
            <column name="scheduled_submit_at" type="TIMESTAMP"/>
        </addColumn>
        <createIndex tableName="pjt_approval_documents" indexName="idx_approval_doc_scheduled">
            <column name="status"/>
            <column name="scheduled_submit_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
