<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-create-menu-access-logs" author="miniproject">
        <createTable tableName="pjt_menu_access_logs">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_pjt_menu_access_logs"/>
            </column>
            <column name="user_id" type="BIGINT"/>
            <column name="user_email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="menu_id" type="BIGINT"/>
            <column name="menu_url" type="VARCHAR(200)"/>
            <column name="menu_name" type="VARCHAR(100)"/>
            <column name="http_method" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="request_uri" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="client_ip" type="VARCHAR(64)"/>
            <column name="user_agent" type="VARCHAR(500)"/>
            <column name="http_status" type="INT"/>
            <column name="access_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="accessed_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="pjt_menu_access_logs" indexName="ix_pjt_menu_access_logs_accessed_at">
            <column name="accessed_at" descending="true"/>
        </createIndex>
        <createIndex tableName="pjt_menu_access_logs" indexName="ix_pjt_menu_access_logs_email">
            <column name="user_email"/>
        </createIndex>
        <addForeignKeyConstraint baseTableName="pjt_menu_access_logs" baseColumnNames="user_id"
                                 referencedTableName="pjt_users" referencedColumnNames="id"
                                 constraintName="fk_pjt_menu_access_logs_user"
                                 onDelete="SET NULL"/>
        <addForeignKeyConstraint baseTableName="pjt_menu_access_logs" baseColumnNames="menu_id"
                                 referencedTableName="pjt_menus" referencedColumnNames="id"
                                 constraintName="fk_pjt_menu_access_logs_menu"
                                 onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
