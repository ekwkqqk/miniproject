<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-demo-items" author="miniproject">
        <createTable tableName="pjt_demo_items">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" primaryKeyName="pk_pjt_demo_items"/>
            </column>
            <column name="name" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="stock" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="owner" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)"/>
            <column name="featured" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="pjt_demo_items" indexName="ix_pjt_demo_items_category">
            <column name="category"/>
        </createIndex>
        <createIndex tableName="pjt_demo_items" indexName="ix_pjt_demo_items_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="pjt_demo_items" indexName="ix_pjt_demo_items_updated_at">
            <column name="updated_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
